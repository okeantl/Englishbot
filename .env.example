# Токен от @BotFather
BOT_TOKEN=

# Локально по умолчанию SQLite; в docker-compose подставляется PostgreSQL
# DATABASE_URL=sqlite+aiosqlite:///./english_bot.db

# ИИ (необязательно). Подходит любой OpenAI-совместимый API.
# Вариант 1: бесплатные модели OpenRouter, ключ на https://openrouter.ai/keys
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemma-4-31b-it:free
# Запасные модели в формате JSON, пробуются по очереди
LLM_FALLBACK_MODELS=["google/gemma-4-26b-a4b-it:free", "nvidia/nemotron-3.5-lightning:free"]

# Вариант 2: GitHub Models (бесплатно с аккаунтом GitHub).
# Токен: https://github.com/settings/personal-access-tokens/new, права Models: Read-only
# LLM_API_KEY=github_pat_...
# LLM_BASE_URL=https://models.github.ai/inference
# LLM_MODEL=openai/gpt-4.1-mini
# LLM_FALLBACK_MODELS=["openai/gpt-4.1-nano"]

# Проверить ключ: python -m scripts.check_llm

# Администраторы: юзернеймы или числовые id через запятую, например @my_name, 123456789
ADMIN_IDS=
TIMEZONE=Europe/Moscow
