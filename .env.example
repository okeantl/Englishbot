# Токен от @BotFather
BOT_TOKEN=

# Локально по умолчанию SQLite; в docker-compose подставляется PostgreSQL
# DATABASE_URL=sqlite+aiosqlite:///./english_bot.db

# ИИ (необязательно). По умолчанию бесплатные модели OpenRouter:
# ключ на https://openrouter.ai/keys, список бесплатных моделей: https://openrouter.ai/models?q=free
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemma-4-31b-it:free
# Запасные модели в формате JSON, пробуются по очереди
LLM_FALLBACK_MODELS=["google/gemma-4-26b-a4b-it:free", "nvidia/nemotron-3.5-lightning:free"]

# Telegram id администраторов в формате JSON: [123456789]
ADMIN_IDS=[]
TIMEZONE=Europe/Moscow
